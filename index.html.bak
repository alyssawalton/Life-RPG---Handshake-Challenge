Mystic:{icon:'✨',role:'Healer / Support',color:'#a56bd1',desc:'The party healer. Restores HP, cleanses pressure, shields allies, and prevents defeat.',passive:'Keen Insight: healing is 15% stronger and quests grant 5% more XP.',ability:{name:'Heal',icon:'💚',cost:10,desc:'Restore 35% of the lowest-health ally’s max HP and give them 20 shield.'},subclasses:[{id:'oracle',name:'Oracle',icon:'🔮',desc:'A predictive support who manipulates fate, Energy, and incoming attacks.',feature:'Foresight grants Evasion and future Energy recovery.'},{id:'luminary',name:'Luminary',icon:'🌟',desc:'A pure healer who creates large shields and emergency recovery.',feature:'Healing and shielding are substantially stronger.'}]},
