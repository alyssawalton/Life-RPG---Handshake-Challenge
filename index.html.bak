function bossHeroPath(id){return 'assets/bosses/'+id+'-hero-hd.png'}

const classes={
Vanguard:{icon:'🛡️',role:'Tank / Protector',color:'#b87935',desc:'The frontline guardian. Built to survive, protect allies, control the boss, and turn defense into momentum.',passive:'Iron Resolve: +25% max HP, +15% Defense, and Guard/Shield effects are 25% stronger.',ability:{name:'Taunt',icon:'🛡️',cost:10,desc:'Gain 55 shield, force the boss to target you, and reduce its next hit by 35%.'},subclasses:[{id:'warden',name:'Warden',icon:'🏰',desc:'A pure protector who turns the party into a fortress.',feature:'+15% Defense, stronger party shields, and defensive skills protect allies.'},{id:'berserker',name:'Berserker',icon:'🪓',desc:'A bruiser who converts missing HP into defensive pressure and counterattacks.',feature:'Gain counterattack power while wounded; still retains high tank durability.'}]},
