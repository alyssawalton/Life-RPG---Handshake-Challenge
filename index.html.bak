<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Life RPG — Chaos Dragon</title>
<style>
:root{--bg:#070b14;--panel:#101827;--panel2:#0c1320;--line:#26344c;--gold:#d9a441;--gold2:#f0c86a;--text:#eef2f7;--muted:#8f9db2;--red:#d94b55;--green:#5cc58a;--blue:#55a9ff;--purple:#a47cff;--cyan:#55d6c2}*{box-sizing:border-box}body{margin:0;background:radial-gradient(circle at 50% -10%,#233452 0,#0a101c 38%,#05070d 100%);color:var(--text);font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;min-height:100vh}button,input,select{font:inherit}button{border:1px solid #3b4b68;background:#172238;color:#fff;border-radius:10px;padding:11px 15px;font-weight:800;cursor:pointer;transition:.15s}button:hover:not(:disabled){transform:translateY(-1px);border-color:#7084a7}button.primary{background:linear-gradient(180deg,#c88d37,#8f5d20);border-color:#e1b45e}button.danger{background:#4d1d27;border-color:#873542}button:disabled{opacity:.4;cursor:not-allowed;transform:none}.hidden{display:none!important}.wrap{max-width:1280px;margin:auto;padding:18px 16px 42px}.topbar{display:flex;align-items:center;justify-content:space-between;border-bottom:1px solid #2a3951;padding:8px 2px 14px;gap:12px}.brand{display:flex;align-items:center;gap:12px}.brandMark{width:42px;height:42px;border:1px solid #a87a2f;border-radius:10px;background:linear-gradient(145deg,#263958,#101722);display:grid;place-items:center;font-size:23px}.brand h1{font-family:Georgia,serif;font-size:22px;margin:0}.brand small{display:block;color:#8f9db2;letter-spacing:.12em;font-size:9px}.nav{display:flex;gap:6px;flex-wrap:wrap}.nav button{background:transparent;border-color:transparent;color:#aab5c9;padding:9px 10px}.nav button.active,.nav button:hover{background:#16243a;color:#fff;border-color:#30445f}.roomPill{border:1px solid #40516c;border-radius:9px;padding:8px 10px;color:#cfd7e6;font-size:12px}.home{display:grid;place-items:center;min-height:72vh}.homeCard{max-width:760px;text-align:center;padding:50px 24px}.eyebrow{font-size:11px;letter-spacing:.18em;color:#d5a64d;font-weight:900}.home h2{font-family:Georgia,serif;font-size:clamp(50px,9vw,86px);margin:12px 0 8px}.home p{color:#aab5c9;font-size:18px;line-height:1.55}.actions{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-top:26px}.panel{background:linear-gradient(180deg,#111b2b,#0b1320);border:1px solid var(--line);border-radius:14px;padding:16px;box-shadow:0 16px 40px #0005}.dashboard{display:grid;grid-template-columns:260px minmax(0,1fr) 280px;gap:12px;margin-top:14px}.sidebar,.rightbar{display:flex;flex-direction:column;gap:12px}.playerCard .avatar{width:62px;height:62px;border-radius:50%;border:2px solid #b27a31;background:#172238;display:grid;place-items:center;font-size:28px;margin-bottom:8px}.playerName{font-family:Georgia,serif;font-size:22px}.levelLine{display:flex;justify-content:space-between;color:#aab5c9;font-size:12px}.xpbar,.hpbar,.energybar{height:9px;background:#05080f;border:1px solid #27344b;border-radius:999px;overflow:hidden}.xpbar i{display:block;height:100%;background:linear-gradient(90deg,#d59b39,#f2d078)}.hpbar i{display:block;height:100%;background:linear-gradient(90deg,#7e2635,#dc5360)}.energybar i{display:block;height:100%;background:linear-gradient(90deg,#287eb9,#59c5ff)}.miniStats{display:grid;grid-template-columns:1fr 1fr;gap:7px;margin-top:12px}.miniStat{padding:9px;background:#0b1320;border:1px solid #202d42;border-radius:9px}.miniStat b{display:block;font-size:18px}.miniStat span{font-size:10px;color:#7f8ca2}.sectionHead{display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:10px}.sectionHead h3{font-family:Georgia,serif;margin:0;font-size:20px}.muted{color:var(--muted);font-size:13px}.bossPanel{padding:0;overflow:hidden}.bossArt{position:relative;min-height:430px;background:#05080d}.bossArt img{width:100%;height:430px;object-fit:contain;object-position:center;background:#05080d;display:block;image-rendering:auto;filter:saturate(.96) contrast(1.04) brightness(.86)}.bossOverlay{position:absolute;inset:0;background:linear-gradient(180deg,#03060b99 0,#0000 35%,#03060bd9 100%);pointer-events:none}.bossHud{position:absolute;top:16px;left:50%;transform:translateX(-50%);width:min(700px,92%);text-align:center}.bossName{font-family:Georgia,serif;font-size:25px;text-shadow:0 2px 8px #000}.bossSub{font-size:11px;color:#c6cfdf;letter-spacing:.14em}.bossHpText{font-weight:900;margin:6px}.bossBar{height:18px;background:#090b10;border:1px solid #8a3540;border-radius:99px;overflow:hidden;box-shadow:0 0 0 2px #0006}.bossBar i{display:block;height:100%;background:linear-gradient(90deg,#7b1827,#ec5862,#8e2532);transition:width .4s}.combatLog{position:absolute;right:14px;bottom:70px;width:min(310px,45%);background:#07101bd9;border:1px solid #33455f;border-radius:10px;padding:10px;font-size:11px;line-height:1.45;backdrop-filter:blur(4px)}.combatLog div{padding:4px 0;border-bottom:1px solid #1b2a3d}.combatLog div:last-child{border:0}.turnBanner{padding:10px 12px;background:#171326;border-top:1px solid #3b3157;border-bottom:1px solid #2a394e;text-align:center}.turnBanner b{color:#f0c86a}.bossMove{margin-top:5px;color:#dca9ff;font-size:11px}.playerHpWrap{margin-top:10px}.playerHpText{display:flex;justify-content:space-between;font-size:11px;color:#aab5c9}.playerHpbar{height:8px;background:#05080f;border:1px solid #27344b;border-radius:999px;overflow:hidden}.playerHpbar i{display:block;height:100%;background:linear-gradient(90deg,#26734b,#5cc58a)}.battleActions{display:grid;grid-template-columns:repeat(4,1fr);gap:8px;padding:10px;background:#0a101b;border-top:1px solid #2a394e}.battleBtn{min-height:62px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px}.battleBtn strong{font-size:13px}.battleBtn span{font-size:10px;color:#9eabc0}.tabs{display:flex;gap:6px;overflow:auto;padding-bottom:6px}.tab{white-space:nowrap;padding:8px 11px;font-size:12px}.tab.active{border-color:#b17c32;background:#2a2112;color:#f2d28b}.questList{display:grid;gap:8px}.quest{display:grid;grid-template-columns:1fr auto;gap:10px;padding:11px;border:1px solid #243149;background:#0a121e;border-radius:10px}.quest.done{opacity:.55}.quest h4{margin:0 0 3px;font-size:14px}.questMeta{font-size:11px;color:#8795ab}.questReward{display:flex;align-items:center;gap:6px;color:#e9c56e;font-size:12px}.diff-Easy{color:#6bd29b}.diff-Medium{color:#e9c56e}.diff-Hard{color:#ed737d}.skillGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px}.skillBranch{border:1px solid #283851;border-radius:11px;padding:10px;background:#0a121e}.skillBranch h4{margin:0 0 8px;font-family:Georgia,serif}.skillNodes{display:grid;grid-template-columns:repeat(3,1fr);gap:7px}.classBranch .skillNodes{grid-template-columns:repeat(4,1fr)}.skillNode{min-height:72px;padding:8px 5px;text-align:center;border:1px solid #2d3b52;border-radius:9px;background:#111b2b;font-size:10px}.skillNode.unlocked{border-color:#b37f37;background:#241c10}.skillNode.available{border-color:#5ca8df}.skillNode .ico{font-size:20px;display:block;margin-bottom:4px}.skillNode button{padding:5px 6px;font-size:9px;margin-top:5px}.cost{color:#dcb65d}.leader{display:grid;gap:7px}.leaderRow{display:flex;justify-content:space-between;align-items:center;background:#0a121e;border:1px solid #202d42;border-radius:9px;padding:9px}.badge{padding:3px 7px;border-radius:999px;background:#242f44;color:#c5d0e0;font-size:10px}.dailyBonus{padding:9px;background:#191a12;border:1px solid #665026;color:#e9c56e;border-radius:9px;font-size:12px}.formPanel{max-width:520px;margin:40px auto}.formPanel input{width:100%;padding:12px;background:#080e18;border:1px solid #2d3b52;color:#fff;border-radius:9px;margin:7px 0 12px}.rules{line-height:1.55;color:#b5c0d0;font-size:13px}.rules li{margin:6px 0}.toast{position:fixed;right:16px;bottom:16px;max-width:360px;background:#101a2a;border:1px solid #3c506d;border-radius:10px;padding:12px 14px;box-shadow:0 15px 35px #0007;z-index:20}.levelUp{position:fixed;inset:0;background:#02040ab8;display:grid;place-items:center;z-index:30}.levelCard{width:min(420px,92%);text-align:center;padding:28px;border:1px solid #bd8735;background:linear-gradient(180deg,#1b1d2a,#0c121e);border-radius:16px;box-shadow:0 0 70px #d39a3838}.levelNumber{font-family:Georgia,serif;font-size:76px;color:#f0c86a}.levelCard h2{font-family:Georgia,serif}.points{font-size:20px;color:#e5c36c}.result{text-align:center;max-width:700px;margin:60px auto}.filterRow{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:10px}.small{font-size:11px}.footerNote{color:#65748b;font-size:11px;margin-top:10px}@media(max-width:1000px){.dashboard{grid-template-columns:1fr}.sidebar,.rightbar{display:grid;grid-template-columns:1fr 1fr}.skillGrid{grid-template-columns:repeat(2,1fr)}}@media(max-width:650px){.classBranch .skillNodes{grid-template-columns:repeat(2,1fr)}.nav{display:none}.sidebar,.rightbar{display:flex}.bossArt img,.bossArt{height:320px;min-height:320px}.combatLog{width:54%;font-size:10px}.battleActions{grid-template-columns:repeat(2,1fr)}.skillGrid{grid-template-columns:1fr}.quest{grid-template-columns:1fr}.quest button{width:100%}}

.avatar{overflow:hidden;position:relative}.avatar.custom{display:grid;place-items:center;font-size:30px;box-shadow:inset 0 0 0 3px #0003}.avatarGlow{position:absolute;inset:0;background:radial-gradient(circle at 50% 35%,#fff6,transparent 55%);pointer-events:none}.avatarIcon{position:relative;z-index:1;filter:drop-shadow(0 2px 2px #0008)}
.avatarEdit{width:100%;margin-top:8px;padding:8px;font-size:11px}.avatarModal{position:fixed;inset:0;background:#02040ad9;display:grid;place-items:center;z-index:40;padding:16px}.avatarCard{width:min(560px,96%);max-height:90vh;overflow:auto;background:linear-gradient(180deg,#172238,#0a101a);border:1px solid #9b7031;border-radius:16px;padding:20px;box-shadow:0 25px 80px #0009}.avatarGrid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin:10px 0 16px}.avatarChoice{height:58px;padding:0;font-size:28px;background:#0c1524;border:1px solid #2b3b55}.avatarChoice.selected{border-color:#e2b75e;box-shadow:0 0 0 2px #e2b75e44 inset;background:#251d10}.toneGrid{display:grid;grid-template-columns:repeat(6,1fr);gap:8px;margin-top:10px}.toneChoice{height:38px;padding:0;border-radius:9px;border:2px solid #33445d}.toneChoice.selected{border-color:#f0c86a;box-shadow:0 0 0 2px #f0c86a44}.skillUse{display:block;width:100%;margin-top:6px;padding:6px;font-size:9px;background:#21344d;border-color:#52749b}.skillUse.ready{background:linear-gradient(180deg,#315a75,#1d3850);border-color:#62b9e8}.skillNode .desc{color:#7f8ca2;font-size:9px;line-height:1.3;margin-top:4px}.battleSkillTray{display:flex;gap:7px;overflow:auto;padding:9px 10px;background:#080e17;border-top:1px solid #202d42}.battleSkill{min-width:115px;text-align:left;padding:8px 10px}.battleSkill b{display:block;font-size:11px}.battleSkill span{font-size:9px;color:#9eabc0}.battleSkill.ready{border-color:#7a5ab4;background:#211b35}.noSkills{color:#7f8ca2;font-size:11px;padding:6px}.questBoard{min-height:620px}.questBoard .quest{grid-template-columns:1fr 160px}.battleOnly{min-height:620px}.battleOnly .bossArt,.battleOnly .bossArt img{height:560px}.dragonFallback{position:absolute;inset:0;display:grid;place-items:center;font-size:110px;background:radial-gradient(circle at 50% 45%,#5d1d2d,#080b13 65%)}
@media(max-width:650px){.avatarGrid,.toneGrid{grid-template-columns:repeat(4,1fr)}.battleSkill{min-width:100px}}

/* === RPG VISUAL PASS v8 === */
:root{
  --bg:#080711;--panel:#11101c;--panel2:#0b0a13;--line:#3a3151;
  --gold:#d8a84e;--gold2:#ffe09a;--gold3:#8c6224;
  --red:#d84a58;--green:#55c98b;--blue:#5ba9ef;--purple:#9b72e8;--cyan:#54d7d0;
  --ink:#f5f0e6;--muted:#a59caf;--shadow:#000b;
}
body{
  background:
    radial-gradient(circle at 50% -15%,#49335e 0,#171126 23%,#090812 58%,#05050a 100%);
  background-attachment:fixed;
}
body:before{
  content:"";position:fixed;inset:0;pointer-events:none;opacity:.12;mix-blend-mode:screen;
  background-image:radial-gradient(#fff 0.7px,transparent .8px);background-size:19px 19px;
}
.wrap{max-width:1380px;padding:20px 18px 48px}
.topbar{
  position:relative;border:1px solid #4a3c5f;border-radius:14px;padding:10px 12px 11px;
  background:linear-gradient(180deg,#171425e8,#0b0a13e8);box-shadow:0 14px 35px #0008,inset 0 1px #ffffff10;
}
.topbar:after,.panel:after,.homeCard:after,.formPanel:after,.levelCard:after{
  content:"";position:absolute;inset:5px;border:1px solid #d6a84d1c;border-radius:10px;pointer-events:none;
}
.brandMark{
  width:48px;height:48px;border:1px solid var(--gold);border-radius:12px;
  background:radial-gradient(circle at 35% 25%,#6e5734,#2a2032 48%,#11101a 75%);
  box-shadow:0 0 20px #d8a84e22,inset 0 0 15px #0008;font-size:26px;
}
.brand h1,.home h2,.sectionHead h3,.playerName,.bossName,.levelCard h2,.result h2{font-family:Georgia,'Times New Roman',serif;letter-spacing:.025em}
.brand h1{font-size:24px;color:#fff5d8;text-shadow:0 2px 8px #000}
.brand small{color:#c4a76b;letter-spacing:.2em}
.nav{gap:4px}
.nav button{
  position:relative;border:1px solid transparent;border-radius:9px;color:#bcb3c7;
  background:linear-gradient(180deg,#1a1625,#0f0d17);padding:10px 13px;box-shadow:inset 0 1px #fff1;
}
.nav button:before{content:"";position:absolute;left:8px;right:8px;bottom:3px;height:1px;background:linear-gradient(90deg,transparent,#d8a84e66,transparent);opacity:0}
.nav button.active,.nav button:hover{color:#fff1c8;border-color:#7e5a29;background:linear-gradient(180deg,#3a2b18,#1d1510);box-shadow:0 0 16px #d8a84e18,inset 0 1px #fff2}
.nav button.active:before{opacity:1}
.roomPill{border-color:#6b5737;background:#18131a;color:#f0d18b;box-shadow:inset 0 1px #fff1}
.panel,.homeCard,.formPanel,.levelCard{
  position:relative;background:linear-gradient(180deg,#171422f2,#0d0c15f2 75%,#0a0910f2);
  border:1px solid #4b3b5c;border-radius:14px;box-shadow:0 18px 50px #0009,inset 0 1px #ffffff0a;
}
.panel{padding:17px}
.sectionHead{padding-bottom:9px;border-bottom:1px solid #3b3048;margin-bottom:12px}
.sectionHead h3{color:#f3e6c4;text-shadow:0 1px 5px #000}
.muted{color:#aaa1b1}
button{
  position:relative;border:1px solid #66536f;border-radius:9px;
  background:linear-gradient(180deg,#2a2338 0%,#171322 52%,#100e17 100%);
  color:#f4eff8;padding:11px 15px;font-weight:900;letter-spacing:.01em;
  box-shadow:inset 0 1px #ffffff18,0 3px 0 #08070c,0 6px 14px #0005;
}
button:after{content:"";position:absolute;inset:2px;border:1px solid #ffffff08;border-radius:7px;pointer-events:none}
button:hover:not(:disabled){transform:translateY(-2px);border-color:#a78a5a;box-shadow:inset 0 1px #fff2,0 4px 0 #08070c,0 10px 22px #0007,0 0 14px #d8a84e16}
button:active:not(:disabled){transform:translateY(1px);box-shadow:inset 0 2px 5px #0008,0 1px 0 #08070c}
button.primary{
  color:#21170a;border-color:#f0c96b;background:linear-gradient(180deg,#ffe39b,#d49a3b 52%,#8b5b20);
  text-shadow:0 1px #ffeab3;box-shadow:inset 0 1px #fff9,0 3px 0 #553512,0 7px 18px #0007,0 0 18px #d8a84e22;
}
button.primary:hover:not(:disabled){border-color:#fff0b5;box-shadow:inset 0 1px #fff,0 4px 0 #553512,0 10px 24px #0008,0 0 24px #d8a84e44}
button.danger{background:linear-gradient(180deg,#6a2631,#34131d);border-color:#a54a58;color:#ffe4e4}
.actions{gap:12px}
.home{min-height:74vh}
.homeCard{padding:56px 30px;overflow:hidden}
.homeCard:before{content:"⚔";position:absolute;top:18px;left:25px;color:#d8a84e44;font-size:30px}.homeCard:after{border-color:#d8a84e18}
.eyebrow{color:#e2b95f;letter-spacing:.24em;text-shadow:0 0 12px #d8a84e22}
.home h2{font-size:clamp(54px,9vw,92px);color:#fff4d5;text-shadow:0 4px 0 #3c2634,0 8px 25px #000;line-height:.95}
.home p{color:#c0b7c5}
.battleOnly{border-color:#594263}
.bossPanel{background:#090811;border-color:#705035;box-shadow:0 0 0 1px #d8a84e12,0 20px 60px #000b}
.bossArt{background:#05050a;min-height:480px}
.bossArt img{height:560px;object-fit:contain;object-position:center;background:#05080d;filter:saturate(1.02) contrast(1.04) brightness(.86)}
.bossArt img[data-phase="2"]{filter:saturate(1.18) contrast(1.08) brightness(.78) hue-rotate(-8deg)}
.bossArt img[data-phase="3"]{filter:saturate(1.28) contrast(1.12) brightness(.68) hue-rotate(-18deg)}
.bossOverlay{background:linear-gradient(180deg,#03040a99 0,#0000 28%,#05040ad9 100%),radial-gradient(circle at 50% 50%,transparent 35%,#0008 100%)}
.bossHud{top:18px}
.bossName{font-size:30px;color:#ffe6ad;text-shadow:0 3px 12px #000,0 0 18px #d8a84e33}
.bossSub{color:#d0c3b0}
.bossHpText{color:#fff1d1}
.bossBar{height:21px;border-color:#a14c4c;box-shadow:0 0 0 2px #0008,0 0 22px #8e253244}
.bossBar i{background:linear-gradient(90deg,#5e0d19,#bd2637 48%,#ff7b50 100%);box-shadow:inset 0 1px #fff3}
.combatLog{background:linear-gradient(180deg,#0b0912e8,#06070ce8);border-color:#675373;box-shadow:0 8px 25px #0008}
.combatLog div{border-color:#31283d}
.battleActions{background:linear-gradient(180deg,#15101c,#0b0910);border-color:#5a4053;padding:12px}
.battleBtn{min-height:72px;border-color:#695070;background:linear-gradient(180deg,#2c2036,#15101d);}
.battleBtn strong{color:#f5e8cb;font-family:Georgia,serif;font-size:14px}.battleBtn span{color:#b7aaba}
.battleBtn:hover:not(:disabled){border-color:#d2a354;background:linear-gradient(180deg,#47331b,#1d1510);box-shadow:0 0 18px #d8a84e22}
.battleSkillTray{background:linear-gradient(180deg,#0c0a12,#08070c);border-top:1px solid #4d394f}
.battleSkill{border-color:#6c517b!important;background:linear-gradient(180deg,#271b33,#120e19)!important;color:#f4e8ff!important}
.battleSkill.ready{border-color:#b58a4a!important;background:linear-gradient(180deg,#49321a,#21150e)!important;box-shadow:0 0 14px #d8a84e1c}
.tabs{border-bottom:1px solid #3c3045;padding:0 2px 8px}
.tab{border-color:#4c3b59;background:linear-gradient(180deg,#201a2b,#100d16);color:#bcb1c5}
.tab.active{border-color:#d2a454;background:linear-gradient(180deg,#4a341a,#21160d);color:#ffe7aa;box-shadow:0 0 14px #d8a84e18}
.quest{border-color:#3b3047;background:linear-gradient(90deg,#15111d,#0d0b13);box-shadow:inset 0 1px #fff1}
.quest:hover{border-color:#75605a;transform:translateX(2px);transition:.15s}
.quest.done{opacity:.6;background:linear-gradient(90deg,#101817,#0b1011)}
.questReward{color:#f1cc75}
.diff-Easy{color:#6fe0a1}.diff-Medium{color:#f1cc75}.diff-Hard{color:#ff7d88}
.skillGrid{gap:12px}.skillGrid .coreBranch{grid-column:1/-1}.skillGrid .classBranch{min-width:0}.skillBranch{border-color:#453650;background:linear-gradient(180deg,#171221,#0c0a12);box-shadow:inset 0 1px #fff1}
.skillBranch h4{color:#f1dfb6}
.skillNode{border-color:#3d3150;background:linear-gradient(180deg,#1b1527,#0d0b13);box-shadow:inset 0 1px #fff1}
.skillNode.unlocked{border-color:#c2954d;background:linear-gradient(180deg,#3a2916,#171008);box-shadow:0 0 15px #d8a84e18,inset 0 1px #fff2}
.skillNode.available{border-color:#5d9dcc;box-shadow:0 0 14px #5ba9ef16}
.skillNode .ico{filter:drop-shadow(0 2px 3px #000)}
.skillUse.ready{background:linear-gradient(180deg,#62461e,#2a1a0d)!important;border-color:#d3a14d!important;color:#ffe7ad!important}
.leaderRow,.miniStat,.dailyBonus{border-color:#3d3147;background:linear-gradient(180deg,#17131f,#0c0a11)}
.badge{background:linear-gradient(180deg,#2b2237,#16111f);border:1px solid #5a4765;color:#d9cde1}
.xpbar,.hpbar,.energybar{background:#05050a;border-color:#45374f;box-shadow:inset 0 2px 5px #0009}
.xpbar i{background:linear-gradient(90deg,#8f5a1f,#f0bd54,#fff0a8);box-shadow:0 0 9px #d8a84e55}
.energybar i{background:linear-gradient(90deg,#275c91,#56c8ff,#b2efff);box-shadow:0 0 9px #55caff44}
.hpbar i{background:linear-gradient(90deg,#671626,#d84657,#ff8b76)}
.playerCard .avatar{border-color:#d2a14d;background:radial-gradient(circle,#35263c,#15101c);box-shadow:0 0 16px #d8a84e1c}
.avatarEdit{background:linear-gradient(180deg,#292037,#14101b)!important;border-color:#6a5273!important}
.formPanel input{background:#090710;border-color:#51405d;box-shadow:inset 0 2px 6px #0008}.formPanel input:focus{outline:2px solid #d8a84e44;border-color:#d8a84e}
.toast{background:linear-gradient(180deg,#20192a,#0d0b13);border-color:#765b83;box-shadow:0 16px 40px #000a,0 0 18px #d8a84e16}
.levelUp{background:#020108d9;backdrop-filter:blur(4px)}
.levelCard{border-color:#d0a14e;box-shadow:0 0 0 1px #fff1,0 0 70px #d8a84e25,0 30px 80px #000c}
.levelNumber{color:#ffe29a;text-shadow:0 3px 0 #5c3d19,0 0 24px #d8a84e55}
.avatarModal{backdrop-filter:blur(6px)}
.avatarCard{background:linear-gradient(180deg,#211a2b,#0d0a13);border-color:#9d753b;box-shadow:0 0 0 1px #fff1,0 25px 80px #000c}
.avatarChoice,.toneChoice{background:linear-gradient(180deg,#241c30,#110e18);border-color:#4f3e5d}.avatarChoice.selected,.toneChoice.selected{border-color:#f0c86a;box-shadow:0 0 0 2px #f0c86a33 inset,0 0 12px #d8a84e22}
.footerNote{color:#75697d}
@media(max-width:650px){.bossArt img,.bossArt{height:350px;min-height:350px}.homeCard{padding:42px 20px}.nav{display:flex;overflow:auto;max-width:100%}.topbar{flex-wrap:wrap}.brand{min-width:190px}}


.classBadge{display:inline-flex;align-items:center;gap:6px;padding:5px 8px;border:1px solid #6e542b;background:#20180d;color:#f0cf82;border-radius:999px;font-size:10px;font-weight:900;margin-top:7px}.classBtn{width:100%;margin-top:8px;background:linear-gradient(180deg,#2a3550,#172238);border-color:#7a6338}.classModal,.subclassModal{position:fixed;inset:0;background:#02040ae8;display:grid;place-items:center;z-index:50;padding:16px}.classCard{width:min(900px,96%);max-height:92vh;overflow:auto;background:linear-gradient(180deg,#18243a,#0a101a);border:1px solid #a77a32;border-radius:18px;padding:20px;box-shadow:0 25px 100px #000b}.classGrid{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}.classChoice{min-height:180px;text-align:left;padding:14px;background:linear-gradient(180deg,#121d30,#0a121f);border:1px solid #2e405d;border-radius:12px}.classChoice:hover{border-color:#b8863b;box-shadow:0 0 18px #c28d3b22}.classChoice.selected{border-color:#e4b85f;box-shadow:0 0 0 2px #e4b85f44 inset,0 0 22px #d7a14b22;background:linear-gradient(180deg,#2a2113,#111827)}.classIcon{font-size:34px}.classChoice h4{font:20px Georgia,serif;margin:7px 0 4px}.classChoice .role{color:#e4b85f;font-size:10px;letter-spacing:.1em;text-transform:uppercase}.classChoice p{color:#9eabc0;font-size:11px;line-height:1.4}.classChoice .passive{margin-top:8px;color:#c8d1df;font-size:10px}.subclassGrid{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:16px}.subclassChoice{text-align:left;padding:16px;background:#0b1422;border:1px solid #2f415d;border-radius:12px}.subclassChoice:hover{border-color:#b8863b}.subclassChoice.selected{border-color:#e4b85f;box-shadow:0 0 0 2px #e4b85f44 inset}.subclassChoice h4{font:21px Georgia,serif;margin:5px 0}.subclassChoice p{color:#aab5c9;font-size:12px;line-height:1.45}.heroPanel{display:grid;grid-template-columns:1.1fr .9fr;gap:12px}.heroSummary{padding:14px;border:1px solid #2a3a54;background:#0a121e;border-radius:12px}.heroClassTitle{font:28px Georgia,serif}.heroSub{color:#e4bd66;font-weight:800}.classFeature{padding:10px;margin-top:10px;border-left:3px solid #c08a3b;background:#16150f;color:#c9d2df;font-size:12px}.lobbyClass{display:flex;justify-content:space-between;align-items:center;gap:10px;flex-wrap:wrap;padding:12px;border:1px solid #2d405b;background:#0a121e;border-radius:10px;margin-top:8px}.lobbyClass .name{font-family:Georgia,serif;font-size:18px}.subclassLocked{color:#77869b;font-size:10px}@media(max-width:800px){.classGrid{grid-template-columns:1fr 1fr}.heroPanel{grid-template-columns:1fr}}@media(max-width:520px){.classGrid,.subclassGrid{grid-template-columns:1fr}}
<style>
.skillTreeTitle{display:flex;justify-content:space-between;align-items:center;gap:12px;padding:12px 14px;margin-bottom:10px;border:1px solid #5a466f;border-radius:12px;background:linear-gradient(135deg,#171226,#0b0b14)}
.coreBranch{border-color:#80602c;background:linear-gradient(180deg,#17140e,#0b0b12)}
.classBranch{position:relative}
.classBranch.branchLocked{opacity:.62}
.branchLock{margin-top:8px;padding:8px 10px;border:1px dashed #4d405d;border-radius:8px;color:#8f86a0;font-size:10px;background:#080810}
.skillNode{transition:.16s;position:relative}
.skillNode.available{box-shadow:0 0 0 1px #8fc8ff33,inset 0 0 18px #4a78a722}
.skillNode.unlocked{box-shadow:inset 0 0 18px #d6a84e18}
.classBranch:not(.branchLocked) .skillNode.available{border-color:#c49a52}
.bossPreview{margin-top:12px;padding:10px;background:#0a121e;border:1px solid #2a3a53;border-radius:12px}.bossPreview img{width:100%;height:150px;object-fit:cover;border-radius:9px;display:block;filter:saturate(.95) contrast(1.05)}.bossPreviewMeta{display:flex;justify-content:space-between;gap:8px;margin-top:8px;align-items:center}.bossPreviewName{font:700 16px Georgia,serif}.bossPreviewStats{font-size:11px;color:#aab5c9}.bossPhaseArt{position:absolute;left:14px;bottom:14px;padding:6px 9px;background:#07101bd9;border:1px solid #40536f;border-radius:999px;font-size:10px;font-weight:900;letter-spacing:.08em}.bossPreview p{margin:6px 0 0}.bossOrder{color:#e7c56e;font-size:10px;letter-spacing:.12em;font-weight:900}</style>

<style>
/* v38 skill tree layout: cards grow naturally instead of overlapping */
.skillGrid{display:block}
.skillTreeTitle{margin-bottom:12px}
.coreBranch,.classBranch{width:100%;margin-bottom:12px}
.skillNodes{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:10px;align-items:stretch}
.classBranch .skillNodes{grid-template-columns:repeat(4,minmax(0,1fr))}
.skillNode{min-height:0;height:auto;display:flex;flex-direction:column;align-items:center;justify-content:flex-start;overflow:hidden;word-break:normal;overflow-wrap:anywhere}
.skillNode .ico{flex:0 0 auto}
.skillNode b{display:block;line-height:1.2;min-height:2.4em}
.skillNode .desc{color:#9eabc0;line-height:1.35;margin:6px 0 2px;flex:1;width:100%}
.skillNode button{margin-top:auto;max-width:100%;white-space:normal;line-height:1.2}
.branchLock{position:relative;z-index:1}
@media(max-width:1000px){.classBranch .skillNodes,.skillNodes{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:650px){.classBranch .skillNodes,.skillNodes{grid-template-columns:1fr}.skillTreeTitle{align-items:flex-start}.skillTreeTitle>div{min-width:0}}
</style></style></head>
<body>
<div class="wrap">
<header class="topbar"><div class="brand"><div class="brandMark">⚔️</div><div><h1>Life RPG</h1><small>REAL TASKS • EPIC PROGRESS</small></div></div><nav class="nav"><button data-view="game" class="active">⚔ Battle</button><button data-view="quests">📜 Quests</button><button data-view="skills">🌳 Skills</button><button data-view="hero">🧙 Hero</button><button data-view="party">👥 Party</button></nav><div style="display:flex;gap:7px;align-items:center"><span id="roomPill" class="roomPill">🌐 Online • No room</span><button id="leaveBtn">Leave</button></div></header>
<section id="home" class="home"><div class="homeCard"><div class="eyebrow">A MULTIPLAYER REAL-LIFE RPG</div><h2>Life RPG</h2><p>Complete useful daily quests, earn XP, unlock combat skills, and work together to defeat the Chaos Dragon.</p><div class="actions"><button id="createBtn" class="primary">Create Game</button><button id="joinBtn">Join Game</button></div><div id="homeForm" class="panel formPanel hidden"></div><div class="footerNote">Best with a friend. Each player can use a separate device.</div></div></section>
<section id="lobby" class="hidden"><div class="panel formPanel"><div class="eyebrow">ADVENTURE PARTY</div><h2 style="font-family:Georgia,serif">Ready Room</h2><div id="roomCode" style="font:800 34px Georgia;color:#e7c56e;letter-spacing:.16em;margin:10px 0"></div><input id="shareLink" readonly><div style="margin-top:12px"><label class="small">BOSS — CAMPAIGN ORDER</label><select id="bossSelect" style="width:100%;padding:10px;background:#080e18;border:1px solid #2d3b52;color:#fff;border-radius:9px;margin-top:5px"></select><div id="bossPreview" class="bossPreview"><img id="bossPreviewImage" src="assets/bosses/chaos-hero.png" alt="Boss preview"><div class="bossPreviewMeta"><div><div id="bossPreviewOrder" class="bossOrder">BOSS 1 / 10</div><div id="bossPreviewName" class="bossPreviewName">THE CHAOS DRAGON</div></div><div id="bossPreviewStats" class="bossPreviewStats">2,000 HP • 150 XP • 25⚡</div></div><p id="bossPreviewDesc" class="muted">The beginning of your journey.</p></div></div><div class="actions" style="justify-content:flex-start"><button id="copyBtn">Copy Join Link</button><button id="startBtn" class="primary">Start Battle</button></div><div id="lobbyPlayers" style="margin-top:16px"></div><div id="lobbyClassArea"></div><p id="lobbyStatus" class="muted"></p><details class="rules"><summary>Rules</summary><ol><li>Each player receives 12 daily quests: 4 Easy, 5 Medium, 3 Hard.</li><li>Completing a quest grants XP and combat energy; during battle, completing a quest uses your turn and does not damage the boss.</li><li>Spend energy on unlocked skills to attack the Chaos Dragon. Unlocked skills appear below the battle buttons and have a Use button in the Skill Tree.</li><li>Leveling follows a Minecraft-inspired cumulative XP curve, scaled 25% harder.</li><li>Every level grants skill points; higher levels grant more. Energy carries between normal levels and fully restores only at major milestones (Levels 5, 10, 15, 20, etc.).</li><li>Choose a class in the lobby. Reach Level 5 to choose a subclass; class features change combat.</li><li>Combat is turn-based: each living player gets one action, then the boss takes a turn.</li><li>Bosses have unique attacks and abilities. Reduce the boss to 0 HP before the party is defeated.</li><li>Bosses are ordered as a campaign from easiest to hardest. After victory, the host can advance the whole party to the next boss without leaving the room.</li><li>Defeating a boss awards every player XP and energy. Harder bosses give larger rewards.</li><li>The party wins when the boss reaches 0 HP.</li></ol></details></div></section>
<section id="app" class="hidden">
<div class="dashboard">
<aside class="sidebar">
<div class="panel playerCard"><div class="avatar custom" id="playerAvatar"><span class="avatarIcon">🧙</span><span class="avatarGlow"></span></div><button class="avatarEdit" id="editAvatar">🎨 Customize Avatar</button><div class="playerName" id="playerName">Player</div><div class="muted" id="playerLevel">Level 1</div><div id="classBadge" class="classBadge">🛡️ Vanguard</div><button id="changeClass" class="classBtn">⚔️ Change Class</button><div class="levelLine"><span id="xpText">0 XP</span><span id="xpNext">Next: 9</span></div><div class="xpbar"><i id="xpBar"></i></div><div class="miniStats"><div class="miniStat"><span>ENERGY</span><b id="energy">0</b></div><div class="miniStat"><span>SKILL PTS</span><b id="skillPoints">0</b></div><div class="miniStat"><span>DEFENSE</span><b id="defense">0%</b></div><div class="miniStat"><span>SHIELD</span><b id="shield">0</b></div></div><div style="margin-top:12px"><div class="levelLine"><span>Combat Energy</span><span id="energyMax">0 max</span></div><div class="energybar"><i id="energyBar"></i></div><div class="playerHpWrap"><div class="playerHpText"><span>HP</span><span id="playerHp">105 / 105 HP</span></div><div class="playerHpbar"><i id="playerHpBar"></i></div></div></div></div>
<div class="panel"><div class="sectionHead"><h3>Attributes</h3></div><div id="attributes"></div></div>
<div class="panel"><div class="sectionHead"><h3>Daily Bonus</h3></div><div class="dailyBonus" id="dailyBonus">Complete quests to unlock bonuses.</div></div>
</aside>
<main>
<div id="viewGame">
<div class="panel bossPanel battleOnly"><div class="bossArt"><img id="bossImage" src="assets/bosses/chaos-phase1.png" alt="Boss battle artwork"><div id="dragonFallback" class="dragonFallback hidden" aria-hidden="true">🐉</div><div class="bossOverlay"></div><div id="bossPhaseArt" class="bossPhaseArt">PHASE I • AWAKENING</div><div class="bossHud"><div class="bossName" id="bossName">THE CHAOS DRAGON</div><div class="bossSub" id="bossSub">ANCIENT • WORLD BOSS • PARTY ENCOUNTER</div><div class="bossHpText" id="bossHp">2,000 / 2,000 HP</div><div class="bossBar"><i id="bossBar"></i></div></div><div class="combatLog" id="combatLog"></div></div><div class="turnBanner"><b id="bossPartyTurn">Your turn</b><div class="bossMove" id="bossMove"></div></div><div class="battleActions"><button class="battleBtn" id="basicAttack"><strong>⚔️ Strike</strong><span>8 energy • 35 dmg</span></button><button class="battleBtn" id="skillAttack"><strong>🔥 Skill Menu</strong><span>View unlocked skills</span></button><button class="battleBtn" id="defendBtn"><strong>🛡 Guard</strong><span>Restore 8 energy</span></button><button class="battleBtn" id="focusBtn"><strong>✨ Focus</strong><span>+20 energy • 1×/turn</span></button><button class="battleBtn" id="skipBtn"><strong>⏭️ Skip Turn</strong><span>0 energy • pass</span></button><button class="battleBtn" id="classAbilityBtn"><strong>✨ Class Ability</strong><span>Role action</span></button></div><div class="battleSkillTray" id="battleSkillTray"></div></div>
</div>
<div id="viewSkills" class="panel hidden"><div class="sectionHead"><h3>Skill Tree</h3><span class="badge" id="skillPointHeader">0 points</span></div><p class="muted">Build a deep class specialization. Every class now has 6 core skills plus 7 skills in each subclass path. Your real-life quest mastery also powers the categories of skills you use.</p><div class="skillGrid" id="skillTree"></div></div>
<div id="viewQuests" class="panel hidden questBoard">
  <div class="sectionHead"><div><h3>Quest Board</h3><span class="muted">Complete quests here to earn XP and Combat Energy.</span></div><span class="badge" id="questCount">0 / 12 complete</span></div>
  <div class="panel questBoardIntro" style="padding:12px;margin-bottom:12px;background:#0a121e">
    <div class="sectionHead"><b>Daily Progress</b><span class="muted" id="questBoardHint">Finish 4, 8, and 12 quests for milestone bonuses.</span></div>
    <div class="xpbar" style="height:12px"><i id="questProgressBar"></i></div>
  </div>
  <div class="filterRow" id="categoryFilters"></div>
  <div class="filterRow" id="difficultyFilters"></div>
  <div class="questList" id="questList"></div>
</div>
<div id="viewHero" class="panel hidden"><div class="sectionHead"><h3>Hero Class</h3><button id="heroChangeClass" class="classBtn" style="width:auto;margin:0">⚔️ Change Class</button></div><div class="heroPanel"><div class="heroSummary"><div id="heroClassIcon" style="font-size:52px">🛡️</div><div id="heroClassTitle" class="heroClassTitle">Vanguard</div><div id="heroClassRole" class="muted">Frontline</div><p id="heroClassDesc" class="muted"></p><div class="classFeature"><b>Class Feature</b><div id="heroPassive"></div></div></div><div class="heroSummary"><div class="eyebrow">SUBCLASS PATH</div><div id="heroSubclassTitle" class="heroSub" style="font-size:24px;margin-top:5px">Choose at Level 5</div><p id="heroSubclassDesc" class="muted">Reach level 5 to specialize your class.</p><button id="heroChooseSubclass" class="primary" style="width:100%;margin-top:10px">Choose Subclass</button><div class="classFeature"><b>How classes work</b><div class="muted" style="margin-top:5px">Your class changes combat rules. Your subclass adds a stronger identity at level 5. Class and subclass bonuses stack with your skill tree.</div></div></div></div></div>
<div id="viewParty" class="panel hidden"><div class="sectionHead"><h3>Party</h3><span class="muted">Work together to defeat the boss</span></div><div class="leader" id="leaderboard"></div></div>
</main>
<aside class="rightbar">
<div class="panel"><div class="sectionHead"><h3>Boss Intel</h3></div><p class="muted">Bosses change tactics as their HP falls. At 50% HP they enter Phase II; below one-third HP they enter Phase III with new attacks and increased damage.</p><div class="miniStat"><span>PHASE</span><b id="bossPhase">I</b></div><div class="miniStat" style="margin-top:7px"><span>PARTY DAMAGE</span><b id="partyDamage">0</b></div></div>
<div class="panel"><div class="sectionHead"><h3>Next Reward</h3></div><div id="nextReward" class="muted">Level up to earn skill points.</div></div>
</aside>
</div></section>
<section id="result" class="hidden"><div class="result panel"><div class="eyebrow">BATTLE COMPLETE</div><h2 id="resultTitle" style="font:48px Georgia;margin:12px 0">Victory</h2><p id="resultText" class="muted"></p><button id="againBtn" class="primary">Next Boss</button></div></section>
</div>
<div id="toast" class="toast hidden"></div>
<div id="classModal" class="classModal hidden" aria-hidden="true"><div class="classCard" role="dialog" aria-modal="true"><div class="sectionHead"><div><div class="eyebrow">CHOOSE YOUR PATH</div><h3 style="font:30px Georgia,serif;margin:5px 0">Select a Class</h3><div class="muted">Click a class, then press Confirm Class.</div></div><button type="button" id="closeClass">✕</button></div><div class="classGrid" id="classChoices"></div><div class="actions" style="justify-content:flex-end"><button type="button" id="cancelClass">Cancel</button><button type="button" id="saveClass" class="primary">Confirm Class</button></div></div></div>
<div id="subclassModal" class="subclassModal hidden"><div class="classCard" style="max-width:720px"><div class="sectionHead"><div><div class="eyebrow">LEVEL 5 SPECIALIZATION</div><h3 style="font:30px Georgia,serif;margin:5px 0">Choose Your Subclass</h3><div class="muted" id="subclassIntro">Your subclass changes how your class fights.</div></div><button type="button" id="closeSubclass">✕</button></div><div class="subclassGrid" id="subclassChoices"></div><div class="actions" style="justify-content:flex-end"><button type="button" id="cancelSubclass">Cancel</button><button type="button" id="saveSubclass" class="primary">Choose Path</button></div></div></div>
<div id="avatarModal" class="avatarModal hidden"><div class="avatarCard"><div class="sectionHead"><h3>Customize Avatar</h3><button id="closeAvatar">✕</button></div><p class="muted">Choose the hero icon and color theme other players will see in your party.</p><div class="small">HERO</div><div class="avatarGrid" id="avatarChoices"></div><div class="small">COLOR THEME</div><div class="toneGrid" id="toneChoices"></div><div class="actions" style="justify-content:flex-end"><button id="cancelAvatar">Cancel</button><button id="saveAvatar" class="primary">Save Avatar</button></div></div></div><div id="levelUp" class="levelUp hidden"><div class="levelCard"><div class="eyebrow">LEVEL UP</div><div class="levelNumber" id="levelNumber">2</div><h2>New power unlocked.</h2><p id="levelUpText" class="points"></p><p class="muted">Open the Skill Tree to spend your points.</p><button id="closeLevel" class="primary">Continue</button></div></div>

<script>
(()=>{
'use strict';
const $=id=>document.getElementById(id);const screens=['home','lobby','app','result'];
let ws=null,isHost=false,myId='',roomCode='',myName='',hostConn=null,connections=new Map(),state=null,view='game',activeCat='All',activeDiff='All';
const cats=['Cooking','Cleaning','Studying','Health','Productivity'];
const bosses={
  chaos:{name:'THE CHAOS DRAGON',subtitle:'ANCIENT • WORLD BOSS • PARTY ENCOUNTER',emoji:'🐉',maxHp:2000,rewardXp:150,rewardEnergy:25,desc:'The beginning of your journey. Master the party system before the real pressure begins.',moves:[
    {name:'Chaos Claw',icon:'🦴',kind:'damage',damage:28,desc:'A brutal swipe at one hero.'},{name:'Flame Breath',icon:'🔥',kind:'aoe',damage:18,desc:'Burns the entire party.'},{name:'Chaos Roar',icon:'📢',kind:'buff',damage:0,desc:'The dragon grows enraged, increasing its next attack.'}],
    phase2Moves:[{name:'Inferno Breath',icon:'🌋',kind:'aoe',damage:28,desc:'A superheated blast that scorches the whole party.'},{name:'Reality Tear',icon:'🕳️',kind:'damage',damage:52,desc:'A rift tears through one hero.'}],
    phase3Moves:[{name:'Cataclysm',icon:'☄️',kind:'aoe',damage:40,desc:'The dragon unleashes a catastrophic blast.'},{name:'Worldbreaker',icon:'💀',kind:'double',damage:30,desc:'Two devastating strikes against one hero.'}]},
  procrastinator:{name:'THE PROCRASTINATOR',subtitle:'TIME THIEF • WORLD BOSS • PARTY ENCOUNTER',emoji:'🧟',maxHp:2400,rewardXp:225,rewardEnergy:35,desc:'Tomorrow always looks easier. This boss punishes parties that waste too many turns.',moves:[
    {name:'Delay Tactics',icon:'⏳',kind:'damage',damage:24,desc:'Slows one hero and steals energy.'},{name:'Deadline Slam',icon:'💥',kind:'damage',damage:38,desc:'A crushing blow.'},{name:'Put It Off',icon:'😴',kind:'heal',damage:0,heal:100,desc:'Heals itself instead of attacking.'}],
    phase2Moves:[{name:'Time Tax',icon:'💸',kind:'drain',damage:22,desc:'Punishes one hero and steals energy.'},{name:'Last Minute Slam',icon:'⏰',kind:'damage',damage:55,desc:'A crushing attack fueled by panic.'}],
    phase3Moves:[{name:'Never Enough Time',icon:'⌛',kind:'double',damage:30,desc:'Two frantic attacks against one hero.'},{name:'Deadline Reset',icon:'🔄',kind:'heal',damage:0,heal:180,desc:'The procrastinator buys itself more time.'}]},
  overthinker:{name:'THE OVERTHINKING OVERLORD',subtitle:'MIND EATER • WORLD BOSS • PARTY ENCOUNTER',emoji:'🧠',maxHp:2800,rewardXp:325,rewardEnergy:50,desc:'Every decision becomes a spiral. Stay focused and keep the party moving.',moves:[
    {name:'Mind Spiral',icon:'🌀',kind:'damage',damage:30,desc:'Deals heavy mental damage.'},{name:'Confusion',icon:'❓',kind:'drain',damage:16,desc:'Hurts one hero and drains energy.'},{name:'Analyze',icon:'🔍',kind:'buff',damage:0,desc:'Studies the party and empowers its next hit.'}],
    phase2Moves:[{name:'Recursive Spiral',icon:'🌀',kind:'damage',damage:48,desc:'A looping thought strikes one hero repeatedly.'},{name:'Paralyzing Doubt',icon:'🫥',kind:'drain',damage:24,desc:'Deals damage and drains energy.'}],
    phase3Moves:[{name:'Mental Collapse',icon:'🧠',kind:'aoe',damage:28,desc:'The boss overloads every hero with thoughts.'},{name:'Perfect Analysis',icon:'📐',kind:'buff',damage:0,desc:'Its next attack becomes massively empowered.'}]},
  deadline:{name:'THE DEADLINE DEMON',subtitle:'TIME PRESSURE • WORLD BOSS • PARTY ENCOUNTER',emoji:'👹',maxHp:3200,rewardXp:450,rewardEnergy:70,desc:'The clock is always ticking. Survive the pressure and hit hard before time runs out.',moves:[
    {name:'Clock Strike',icon:'🕰️',kind:'damage',damage:35,desc:'A fast strike against one hero.'},{name:'Panic Wave',icon:'😱',kind:'aoe',damage:15,desc:'Hits every hero.'},{name:'Rush Hour',icon:'⚡',kind:'double',damage:20,desc:'Attacks the same hero twice.'}],
    phase2Moves:[{name:'Countdown Strike',icon:'🔔',kind:'damage',damage:50,desc:'A heavy hit as the clock races down.'},{name:'Overtime Rush',icon:'🏃',kind:'double',damage:28,desc:'Two rapid strikes against one hero.'}],
    phase3Moves:[{name:'Final Hour',icon:'🌑',kind:'aoe',damage:30,desc:'The final countdown damages the entire party.'},{name:'Doomsday Clock',icon:'☠️',kind:'damage',damage:65,desc:'A devastating final-hour attack.'}]},
  jobhunter:{name:'THE REJECTION REAPER',subtitle:'JOB HUNT • CAREER NIGHTMARE • WORLD BOSS',emoji:'📄',maxHp:3600,rewardXp:600,rewardEnergy:90,desc:'Applications, ghosting, interviews, and rejection letters. Keep applying.',moves:[
